<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- E2E test project lives under this repo folder; SDK would otherwise compile its *.cs into the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);StVrainToICSFunctionApp.E2ETests/**</DefaultItemExcludes>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.6.0" />
    <PackageReference Include="Ical.Net" Version="5.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StVrainToICSFunctionApp.E2ETests" />
  </ItemGroup>
</Project>
