# Copied to /etc/stvrain-lunch-menu.env inside the LXC.
# systemd EnvironmentFile does not expand quotes; do not wrap values in quotes.

ASPNETCORE_URLS=http://0.0.0.0:8080
ASPNETCORE_ENVIRONMENT=Production

# Menu window relative to today (days).
DefaultStartOffset=-7
DefaultEndOffset=30

# LINQ Connect (optional; defaults match St. Vrain).
# APIEndpoint=https://api.linqconnect.com
# LinqDistrictMenuCode=DCN3CB
# LinqPublicMenuBuildingId=67673211-c4be-ed11-82b1-880d996bcdd8
# LinqApiReferer=
# LinqUserAgent=
# LinqNutritionUrl=
LinqMinimalBrowserHeaders=false
LinqUseHttp2=false

# SQLite menu cache (origin mode). Nested config uses double underscores.
Cache__Enabled=true
Cache__TtlMinutes=360
Cache__DatabasePath=data/menu-cache.db

# Azure proxy mode stays off on the LXC origin.
Proxy__Enabled=false
Proxy__UpstreamBaseUrl=https://lunchmenu.debugthings.com

# Optional Azure Monitor. Leave empty to disable.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
